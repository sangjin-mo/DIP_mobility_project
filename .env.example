# Dashboard server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Vision team's pc_server (image transfer relay)
DASHBOARD_VISION_SERVER_URL=

# Webcam Raspberry Pi. capture.py owns port 8002; the WEB-owned transition
# receiver uses port 8003 so both processes can run together.
DASHBOARD_VISION_PI_CAPTURE_URL=http://WEBCAM_PI_IP:8002
DASHBOARD_VISION_PI_STATE_URL=http://WEBCAM_PI_IP:8003/api/drive-state
DASHBOARD_VISION_PI_STATE_TOKEN=

# KMA Village Forecast API
# Use the decoded general service key shown in your data.go.kr account.
DASHBOARD_KMA_SERVICE_KEY=
DASHBOARD_KMA_NX=89
DASHBOARD_KMA_NY=90
DASHBOARD_WEATHER_LOCATION_LABEL=대구광역시 수성구
DASHBOARD_WEATHER_REFRESH_INTERVAL_MINUTES=30
DASHBOARD_WEATHER_TIMEOUT_S=5

# Raspberry Pi control agent (optional until hardware integration)
DASHBOARD_ROVER_CONTROL_URL=
DASHBOARD_ROVER_CONTROL_TOKEN=

# Optional: lets scripts/start_central_server.sh best-effort start the
# drive Pi's control process over SSH before the dashboard comes up.
# Leave blank to skip the remote start (the script still checks reachability).
DRIVE_PI_SSH_HOST=
DRIVE_PI_SSH_USER=pi
